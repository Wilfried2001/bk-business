{
  "name": "bkbusiness/app",
  "description": "Application de gestion BK Business",
  "type": "project",
  "autoload": {
    "classmap": [
      "core/",
      "app/controllers/",
      "app/models/",
      "app/validation/"
    ],
    "files": [
      "core/Helpers.php"
    ]
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "require": {
    "php": ">=8.0",
    "dompdf/dompdf": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "process-timeout": 0
  },
  "require-dev": {
    "phpunit/phpunit": "11"
  }
}
